		"layout": {
			"wideSize": "1200px",
			"contentSize": "800px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "System",
					"slug": "system",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"name": "Monospace",
					"slug": "mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, monospace"
				},
				{
					"name": "Serif",
					"slug": "serif",
					"fontFamily": "'Instrument Serif', Georgia, serif"
				}
			],
			"fontSizes": [
				{
					"slug": "sm",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "md",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "lg",
					"size": "1.25rem",
					"name": "Large"
				},
				{
					"slug": "xl",
