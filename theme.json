{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"custom": false,
			"defaultPalette": false
		},
		"typography": {
			"fluid": true,
			"customFontSize": false
		},
		"spacing": {
			"spacingScale": {
				"steps": 7
			}
		}
	}
}